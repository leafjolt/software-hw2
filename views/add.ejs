<%- include('partials/header') %>

<div class="container">
  <h1>Add a New Recipe</h1>
  <form action="/add" method="POST">
    <div class="form-group">
      <label for="title">Recipe Title:</label>
      <input type="text" name="title" id="title" required>
    </div>

    <div class="form-group">
      <label for="description">Short Description:</label>
      <textarea name="description" id="description" required></textarea>
    </div>

    <div class="form-group">
      <label for="instructions">Instructions:</label>
      <textarea name="instructions" id="instructions" required></textarea>
    </div>

    <div class="form-group">
      <label for="main_protein">Main Protein:</label>
      <select name="main_protein" id="main_protein" required>
        <option value="">-- Choose --</option>
        <option value="Chicken">Chicken</option>
        <option value="Beef">Beef</option>
        <option value="Tofu">Tofu</option>
        <option value="Grains">Grains</option>
      </select>
    </div>

    <div class="form-group">
      <label>Ingredients (select what’s used):</label>
      <div class="ingredient-list">
        <% ingredients.forEach(ingredient => { %>
          <label class="ingredient-option">
            <input type="checkbox" name="ingredients" value="<%= ingredient.id %>">
            <%= ingredient.name %>
          </label>
        <% }) %>
      </div>
    </div>

    <button type="submit" class="submit-button">Add Recipe</button>
  </form>
</div>

<%- include('partials/footer') %>